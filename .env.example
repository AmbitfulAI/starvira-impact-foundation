# Copy to your hosting provider's environment variables (Vercel: Project Settings > Environment Variables).
# Never commit real values to Git.

# Public address of the live site, used for canonical links and the sitemap
SITE_URL=https://www.your-domain.org

# ---- Form delivery (Resend, https://resend.com) ----
RESEND_API_KEY=
FORMS_TO_EMAIL=info@your-domain.org            # comma-separated list allowed
FORMS_FROM_EMAIL="Starvira Website <forms@your-domain.org>"  # must be a domain verified in Resend
PUBLIC_CONTACT_EMAIL=info@your-domain.org       # shown to visitors if form delivery is unavailable

# ---- Optional spam protection (Cloudflare Turnstile) ----
# Also add the matching site key in content/site.json > forms.turnstileSiteKey
TURNSTILE_SECRET_KEY=

# ---- Content manager sign-in (GitHub OAuth App) ----
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_SCOPE=repo,user   # use public_repo,user if the repository is public

# ---- Local development only ----
# MAIL_MODE=log   # print submissions to the console instead of sending email
